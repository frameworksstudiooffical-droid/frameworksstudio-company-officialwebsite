# Frameworks Studio Contact API Environment Configuration Template
# Copy this file to .env and fill in your actual production values

API_BASE_URL=https://your-api-domain.up.railway.app
CONTACT_ENDPOINT=https://your-api-domain.up.railway.app/api/contact
CLOUDFLARE_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key_here
WHATSAPP_NUMBER=your_whatsapp_number_without_plus_or_spaces
